<Layouts.app flash={@flash} current_scope={@current_scope}>
  <.header>
    ZamHealthWatch
    <:subtitle>
      A real-time disease outbreak tracking and early warning prototype for Zambia. Case
      reporting, lab confirmation, vaccination coverage, drug stock, hospital capacity, risk
      scoring, mapping, and national reporting, all connected so a new report shows up on
      every relevant screen as it happens.
    </:subtitle>
  </.header>

  <div class="alert alert-warning">
    <.icon name="hero-exclamation-triangle" class="size-5 shrink-0" />
    <span>
      This is a portfolio prototype running on demo data. It is not a Ministry of Health
      system and holds no real patient information.
    </span>
  </div>

  <%= if @current_scope && @current_scope.user do %>
    <p>
      You're logged in as <span class="font-semibold">{@current_scope.user.email}</span>.
      Start from the <.link href={~p"/portal"} class="link">Portal</.link>
      or pick a screen from the menu above.
    </p>
  <% else %>
    <.header>
      Try it with a demo account
      <:subtitle>
        Each role sees a different slice of the system. The password for all three is
        <code class="font-mono">{@demo_password}</code>
        - use the password form on the login page, since email login links aren't sent on
        this demo.
      </:subtitle>
    </.header>

    <.table id="demo-accounts" rows={@demo_accounts}>
      <:col :let={account} label="Role">{account.label}</:col>
      <:col :let={account} label="Email">
        <code class="font-mono">{account.email}</code>
      </:col>
      <:col :let={account} label="What it can see">{account.note}</:col>
    </.table>

    <.button href={~p"/users/log-in"} variant="primary">Log in</.button>

    <p class="text-sm text-base-content/60">
      These accounts are shared by everyone trying the demo, so their roles and password are
      reset every time the app restarts.
    </p>
  <% end %>

  <div class="divider" />

  <p class="text-sm text-base-content/70">
    Built with Elixir, Phoenix LiveView, PubSub, Oban, Broadway, and Nx. The source and the
    full iteration-by-iteration build log are on
    <.link href="https://github.com/Phil-Samakayi/zamhealthwatch" class="link">GitHub</.link>.
  </p>
</Layouts.app>
